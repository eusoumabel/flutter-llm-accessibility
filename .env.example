# Copie este arquivo para .env e preencha os valores locais reais.
# Chaves de API e segredos do provedor nunca devem ser enviados para o Git.

# Use LLM_PROVIDER=gemini to run against Google Gemini.
LLM_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0
