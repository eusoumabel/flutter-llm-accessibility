# Copie este arquivo para .env e preencha os valores locais reais.
# Chaves de API e segredos dos provedores nunca devem ser enviados para o Git.

# Provedores executados em cada rodada, separados por vírgula: gemini, claude
LLM_PROVIDERS=gemini,claude

# Google Gemini (chave em https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0

# Anthropic Claude (chave em https://platform.claude.com/settings/keys)
# Claude Opus 5.5 não aceita temperature; o raciocínio é controlado por CLAUDE_EFFORT
# (low, medium, high, xhigh, max). Não há fallback para outro modelo (ADR-R017).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
CLAUDE_MAX_TOKENS=16000
